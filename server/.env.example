# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/billbook_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/billbook_dev?retryWrites=true&w=majority

# CORS
CORS_ORIGIN=http://localhost:5173

# Security & Secrets (at least 32 characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_123456789
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_123456789
